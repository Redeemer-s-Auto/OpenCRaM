# Garden Work production configuration
# Copy to .env.garden on the self-hosted server. Never commit .env.garden or the Firebase credential JSON.

# Public Garden URLs
GARDEN_WORK_URL=https://work.aphrisoft.com
GARDEN_ADMIN_URL=https://gardenchurch.web.app/admin
SITE_ADDRESS=work.aphrisoft.com
# Include loopback hosts because the Docker/API readiness probes call the API over 127.0.0.1.
# Public traffic still reaches the app only through work.aphrisoft.com via Caddy.
ALLOWED_HOSTS=work.aphrisoft.com,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://gardenchurch.web.app
GARDEN_AUTH_ALLOWED_ORIGINS=https://gardenchurch.web.app
CERT_EMAIL=

# Garden / Firebase identity
GARDEN_AUTH_ENABLED=1
GARDEN_FIREBASE_PROJECT_ID=church-2612f
GARDEN_FIREBASE_CREDENTIALS_PATH=/opt/garden/secrets/firebase-service-account.json
GARDEN_FIRESTORE_PROFILE_SYNC=1
GARDEN_WORKSPACE_NAME=The Garden
GARDEN_WORKSPACE_SLUG=the-garden
GARDEN_WORKSPACE_TIMEZONE=America/Chicago
# Enable only for the very first approved admin login that creates the managed workspace, then return to 0.
GARDEN_WORKSPACE_BOOTSTRAP=0

# Garden Work server-to-server integration.
# `garden_integration_token` creates/reconciles a dedicated local service user and Plane API token.
GARDEN_INTEGRATION_USER_EMAIL=garden-work-integration@garden.invalid
GARDEN_INTEGRATION_TOKEN_LABEL=Garden Work server integration
GARDEN_INTEGRATION_RATE_LIMIT=600/min
# `garden_integration_webhook` creates/reconciles the Work -> Firebase signed webhook.
# The URL is the deployed `workPlaneWebhook` HTTPS function URL.
GARDEN_WORK_WEBHOOK_URL=
# Generate a high-entropy value (32+ characters) and store the same value in
# Firebase Functions secret PLANE_WORK_WEBHOOK_SECRET.
GARDEN_WORK_WEBHOOK_SECRET=

# Application secrets. Generate unique high-entropy values before deployment.
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=

# PostgreSQL
POSTGRES_USER=garden_plane
POSTGRES_PASSWORD=
POSTGRES_DB=garden_plane
POSTGRES_PORT=5432

# Valkey
REDIS_URL=redis://plane-redis:6379/0

# RabbitMQ
RABBITMQ_USER=garden_plane
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=garden_plane

# Object storage
AWS_REGION=
AWS_ACCESS_KEY_ID=garden_plane_storage
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=uploads
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
USE_MINIO=1
MINIO_ENDPOINT_SSL=0
# Pin a currently supported self-hosted S3-compatible image before deployment.
# Do not use an unpinned :latest tag in production.
MINIO_IMAGE=

# Runtime
DEBUG=0
FILE_SIZE_LIMIT=10485760
API_KEY_RATE_LIMIT=60/minute
SESSION_COOKIE_NAME=garden-work-session
# Leave blank for a host-only cookie on work.aphrisoft.com.
COOKIE_DOMAIN=
SESSION_SAVE_EVERY_REQUEST=0
ENABLE_SIGNUP=0
SCOUT_MONITOR=0
POSTHOG_API_KEY=
ANALYTICS_SECRET_KEY=
ANALYTICS_BASE_API=
INSTANCE_CHANGELOG_URL=

# Public ports. Database/cache/queue/object-storage ports are intentionally not published.
# Binding to the Hostinger public IPv4 avoids collisions with Tailscale listeners on its private interface.
PUBLIC_BIND_IP=187.77.15.201
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# Optional local image names. These are built from the vendored source by scripts/plane-garden/deploy.sh.
GARDEN_PLANE_WEB_IMAGE=garden-plane-web:local
GARDEN_PLANE_API_IMAGE=garden-plane-api:local
GARDEN_PLANE_SPACE_IMAGE=garden-plane-space:local
GARDEN_PLANE_ADMIN_IMAGE=garden-plane-admin:local
GARDEN_PLANE_LIVE_IMAGE=garden-plane-live:local
GARDEN_PLANE_PROXY_IMAGE=garden-plane-proxy:local
